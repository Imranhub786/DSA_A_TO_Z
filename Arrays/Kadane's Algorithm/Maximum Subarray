Brute_Force:
class Solution {
    int maxSubarraySum(int[] arr) {
        // 1. Guard clause for null or empty array
        if (arr == null || arr.length == 0) {
            return 0; // Or throw new IllegalArgumentException("Array cannot be empty");
        }

        // 2. Safe to access arr[0] now because at least 1 element exists
        int maxSum = arr[0];

        for (int i = 0; i < arr.length; i++) {
            int sum = 0;
            for (int j = i; j < arr.length; j++) {
                sum += arr[j];
                maxSum = Math.max(maxSum, sum);
            }
        }
        return maxSum;
    }
}

Optimize Approach:
class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here
        if(arr==null || arr.length==0){
            return 0;
        }
        int maxSum=arr[0];
        int curSum=0;
        for(int num : arr){
            curSum+=num;
            maxSum=Math.max(maxSum, curSum);
            if(curSum < 0){
                curSum=0;
            }
        }
       
        return maxSum;
    }
}
