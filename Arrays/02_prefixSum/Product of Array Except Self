Brute Force Approach:
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int []res=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            int prod=1;
            for(int j=0;j<nums.length;j++){
                if(i==j){
                    continue;
                }
                prod *=nums[j];
            }
            res[i]=prod;
        }
        return res;
    }
}

Optimize approach:

class Solution {
    public int[] productExceptSelf(int[] nums) {

        int n = nums.length;
        int[] res = new int[n];

        // Store left products in res
        res[0] = 1;

        for (int i = 1; i < n; i++) {
            res[i] = res[i - 1] * nums[i - 1];
        }

        // Build right product while moving right → left
        int rightProduct = 1;

        for (int i = n - 1; i >= 0; i--) {

            res[i] = res[i] * rightProduct;

            rightProduct *= nums[i];
        }

        return res;
    }
}
