class Solution {
    public int findMaxLength(int[] nums) {
        int maxLen=0;
        for(int i=0;i<nums.length;i++){
            int zero=0;
            int one=0;
            for(int j=i;j<nums.length;j++){
                if(nums[j]==0){
                    zero++;
                }else{
                    one++;
                }
                if(zero==one){
                    maxLen=Math.max(maxLen, j-i+1);
                }
            }
        }
        return maxLen;
        
    }
}


