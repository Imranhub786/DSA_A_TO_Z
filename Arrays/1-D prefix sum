Brute force
class Solution {
    public ArrayList<Integer> prefSum(int[] arr) {

        ArrayList<Integer> list = new ArrayList<>();

        if (arr == null || arr.length == 0) {
            return list;
        }

        for (int i = 0; i < arr.length; i++) {

            int sum = 0;

            for (int j = 0; j <= i; j++) {
                sum += arr[j];
            }

            list.add(sum);
        }

        return list;
    }
}


