Brute Force:

class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n=nums.length;
        int []res=new int[n-k+1];
        for(int i=0;i<=n-k;i++){
            int max=nums[i];
            for(int j=i;j<i+k;j++){
                max=Math.max(max, nums[j]);
            }
            res[i]=max;
        }
        return res;
        
    }
}

Optimize Approach:
class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n=nums.length;
        int []res=new int[n-k+1];
        Deque<Integer>dque=new LinkedList<>();
        for(int right=0;right<n;right++){
            while(!dque.isEmpty() && dque.peekFirst() <= right- k){
                dque.pollFirst();
            }
            while(!dque.isEmpty() && nums[dque.peekLast()] < nums[right]){
                dque.pollLast();
            }
            dque.addLast(right);
            if(right >= k-1){
                res[right - k + 1]=nums[dque.peekFirst()];

            }
        }
        return res;
        
    }
}
