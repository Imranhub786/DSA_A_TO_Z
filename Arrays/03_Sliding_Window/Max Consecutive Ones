Optimal Approach:
class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int count=0;
        int maxi=0;
        int n=nums.length;
        int j=0;
        while(j < n){
            if(nums[j]==1){
                count++;
            }else{
                maxi=Math.max(maxi, count);
                count=0;
            }
            j++;
        }
        return Math.max(maxi,count);
    }
}

